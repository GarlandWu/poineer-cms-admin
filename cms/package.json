{
  "name": "energy-portal-cms",
  "version": "0.1.0",
  "private": true,
  "description": "本地内容创作后台 (Payload CMS) —— 仅本地运行，构建期导出 JSON 供主站 SSG 读取",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run ./src/scripts/seed.ts",
    "export": "cross-env NODE_OPTIONS=--no-deprecation payload run ./src/scripts/export.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.33.0",
    "@payloadcms/next": "^3.33.0",
    "@payloadcms/richtext-lexical": "^3.33.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "15.2.9",
    "payload": "^3.33.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
