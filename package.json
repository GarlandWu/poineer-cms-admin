{
  "name": "energy-digital-twin-portal",
  "version": "0.1.0",
  "author": "Garland Wu",
  "private": true,
  "description": "能源数据采集与数字孪生系统企业门户 — Next.js SSG",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "preview": "npx --yes serve out -l 5000",
    "start": "npx serve@latest out",
    "deploy": "next build",
    "publish": "node scripts/publish.js",
    "lint": "next lint",
    "app": "node app-manager.js",
    "app:build": "pkg app-manager.js --output dist/EnergyPortalManager.exe --targets win-x64 --node-range 20",
    "electron": "electron electron/main.js",
    "electron-dev": "electron electron/main.js",
    "electron-build": "npm run build --prefix cms && electron-builder --win portable"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wait-on": "^7.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": "pkg-manager.js",
  "pkg": {
    "assets": [
      "cms/**/*",
      "src/**/*", 
      "public/**/*",
      "scripts/**/*",
      "next.config.js",
      "tsconfig.json",
      "tailwind.config.ts",
      "postcss.config.js",
      "package.json",
      "package-lock.json"
    ],
    "targets": [
      "win-x64"
    ],
    "scripts": [
      "pkg-manager.js"
    ]
  },
  "build": {
    "appId": "com.pioneer-cms.portal",
    "productName": "EnergyPortalManager",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "electron-ui/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "cms/.next/standalone",
        "to": "cms"
      },
      {
        "from": "cms/.next/static",
        "to": "cms/.next/static"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "EnergyPortalManager.exe"
    }
  }
}
